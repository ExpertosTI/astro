#!/bin/bash
set -e

echo "🚀 Iniciando Despliegue vía Git..."

# 1. Compilar Assets en Local (Mac)
echo "🛠 1/3 Compilando assets..."
cd site
npm run build
cd ..

# 2. Subir cambios a Git
echo "📤 2/3 Sincronizando con Git..."
git add .
git commit -m "deploy: production build and cleanup" || echo "No hay cambios para commitear"
git push origin main

# 3. Informar éxito local
echo "✅ Proceso local completado."
echo "🚀 Los cambios ya están en GitHub. Ahora puedes entrar al VPS y ejecutar ./deploy.sh"
