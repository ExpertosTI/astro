#!/bin/bash
set -e

# 1. Verificar y descargar SFX si faltan
SFX_DIR="site/public/astro/sfx"
mkdir -p "$SFX_DIR"
if [ ! -f "$SFX_DIR/glitch.mp3" ]; then
    echo "🎵 Descargando efectos de sonido necesarios..."
    curl -L -s -o "$SFX_DIR/glitch.mp3" "https://cdn.pixabay.com/audio/2022/03/10/audio_5e2c5d5e21.mp3"
    curl -L -s -o "$SFX_DIR/type.mp3" "https://cdn.pixabay.com/audio/2022/03/15/audio_24e2d31c62.mp3"
    curl -L -s -o "$SFX_DIR/click.mp3" "https://cdn.pixabay.com/audio/2022/03/10/audio_c8de3165b6.mp3"
    curl -L -s -o "$SFX_DIR/transition.mp3" "https://cdn.pixabay.com/audio/2022/03/24/audio_3d1981a3d9.mp3"
    echo "✅ Sonidos preparados."
fi

echo "🚀 Iniciando Despliegue vía Git..."

# 1. Compilar Assets en Local (Mac)
echo "🛠 1/3 Compilando assets..."
cd site
npm run build
cd ..

# 2. Subir cambios a Git
echo "📤 2/3 Sincronizando con Git..."
git add .
git commit -m "deploy: production build and cleanup" || echo "No hay cambios para commitear"
git push origin main

# 3. Informar éxito local
echo "✅ Proceso local completado."
echo "🚀 Los cambios ya están en GitHub. Ahora puedes entrar al VPS y ejecutar ./deploy.sh"
