#!/bin/bash
set -e

echo "🔍 Validating project before push..."

# 1. Run build in site/
cd site
echo "🛠 Running build..."
npm run build
cd ..

# 2. Add all to git (respecting .gitignore)
echo "📦 Staging files..."
git add .

# 3. Commit
echo "💾 Enter commit message (or press Enter for 'feat: implementation update'):"
read message
if [ -z "$message" ]; then
    message="feat: implementation update"
fi
git commit -m "$message" || echo "No changes to commit"

# 4. Push
echo "🚀 Pushing to origin main..."
git push origin main

echo "✅ Done! Ready for VPS deploy."
